{
  "name": "guia-nsn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Apostolado Nossa Senhora das Neves - guia do Rito Romano na forma do Missal de São Pio V",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "checar-tipos": "tsc -b --noEmit",
    "publicar": "npm run build && npx --yes wrangler@4.85.0 deploy",
    "test": "esbuild src/calendario/calendario.teste.ts --bundle --platform=node --format=cjs --outfile=.teste/calendario.cjs --log-level=warning && node .teste/calendario.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
