# Os arquivos de /assets levam hash no nome, então podem ser guardados para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O brasão muda pouco, mas não tem hash: uma semana, revalidando depois.
/brasao*.png
  Cache-Control: public, max-age=604800, must-revalidate

# O HTML nunca fica em cache, senão uma atualização do guia demora a aparecer.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
